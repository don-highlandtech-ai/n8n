    {
      "parameters": {
        "jsCode": "// Check which leads need follow-ups based on timing\nconst results = $input.first().json.results || [];\nconst config = $('Set Config').first().json;\nconst now = Date.now();\n\nconst leadsToFollowUp = [];\nconst staleLeads = [];\n\nfor (const contact of results) {\n  const props = contact.properties || {};\n  const email = props.email;\n  const firstName = props.firstname || '';\n  const lastName = props.lastname || '';\n  const company = props.company || '';\n  const status = props.intake_status || 'new';\n  const score = parseInt(props.intake_score) || 0;\n  const followupCount = parseInt(props.followup_count) || 0;\n  const lastFollowupStr = props.last_followup_date;\n  \n  // Skip if already booked, disqualified, or stale\n  if (['booked', 'disqualified', 'stale'].includes(status)) continue;\n  \n  // Parse last followup date\n  let lastFollowup = lastFollowupStr ? new Date(lastFollowupStr).getTime() : (new Date(contact.createdAt)).getTime();\n  const hoursSinceLastContact = (now - lastFollowup) / (1000 * 60 * 60);\n  \n  // Determine if follow-up is due\n  let followUpNumber = null;\n  \n  if (followupCount === 0 && hoursSinceLastContact >= config.followup1Hours) {\n    followUpNumber = 1;\n  } else if (followupCount === 1 && hoursSinceLastContact >= (config.followup2Hours - config.followup1Hours)) {\n    followUpNumber = 2;\n  } else if (followupCount === 2 && hoursSinceLastContact >= (config.followup3Hours - config.followup2Hours)) {\n    followUpNumber = 3;\n  } else if (followupCount >= 3 && hoursSinceLastContact >= (config.staleHours - config.followup3Hours)) {\n    // Mark as stale\n    staleLeads.push({\n      contactId: contact.id,\n      email,\n      firstName,\n      lastName,\n      company,\n      score,\n      status: 'stale'\n    });\n    continue;\n  }\n  \n  if (followUpNumber !== null) {\n    leadsToFollowUp.push({\n      contactId: contact.id,\n      email,\n      firstName,\n      lastName,\n      company,\n      status,\n      score,\n      followupCount,\n      followUpNumber,\n      hoursSinceLastContact: Math.round(hoursSinceLastContact)\n    });\n  }\n}\n\n// Return combined results\nconst allResults = [\n  ...leadsToFollowUp.map(l => ({ json: { ...l, action: 'followup' } })),\n  ...staleLeads.map(l => ({ json: { ...l, action: 'stale' } }))\n];\n\nif (allResults.length === 0) {\n  return [{ json: { noFollowupsNeeded: true } }];\n}\n\nreturn allResults;"
      },
