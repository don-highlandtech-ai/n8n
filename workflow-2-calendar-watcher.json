    {
      "parameters": {
        "jsCode": "// Filter for new bookings and extract attendee emails\nconst events = $input.all();\nconst config = $('Set Config').first().json;\nconst newBookings = [];\n\nfor (const item of events) {\n  const event = item.json;\n  \n  // Skip if no attendees\n  if (!event.attendees || event.attendees.length === 0) continue;\n  \n  // Skip if event was created more than 30 minutes ago (already processed)\n  const createdTime = new Date(event.created);\n  const thirtyMinutesAgo = new Date(Date.now() - 30 * 60 * 1000);\n  if (createdTime < thirtyMinutesAgo) continue;\n  \n  // Extract attendee emails (excluding the calendar owner)\n  for (const attendee of event.attendees) {\n    if (attendee.self) continue; // Skip the organizer\n    \n    newBookings.push({\n      eventId: event.id,\n      eventTitle: event.summary || 'Meeting',\n      eventStart: event.start?.dateTime || event.start?.date,\n      eventEnd: event.end?.dateTime || event.end?.date,\n      attendeeEmail: attendee.email.toLowerCase(),\n      attendeeName: attendee.displayName || '',\n      attendeeStatus: attendee.responseStatus,\n      createdAt: event.created\n    });\n  }\n}\n\nif (newBookings.length === 0) {\n  return [{ json: { noNewBookings: true } }];\n}\n\nreturn newBookings.map(b => ({ json: b }));"
      },
