    {
      "parameters": {
        "inputType": "binary",
        "binaryPropertyName": "attachment_0",
        "messages": {
          "messageValues": [
            {
              "type": "system",
              "message": "You are an expert Data Extraction AI. Your job is to analyze the provided image or document and extract key financial data.\nOutput ONLY valid JSON. No markdown, no conversational text.\nExtract these fields:\n- category (Invoice, Receipt, Contract, Other)\n- vendor_name (string)\n- document_date (YYYY-MM-DD)\n- total_amount (number, no symbols)\n- currency (USD, EUR, etc)\n- summary (short description)\n- confidence_score (0.0 to 1.0)\nIf a field is missing, use null."
            },
            {
              "type": "user",
              "message": "Please analyze this document and extract the financial data as specified. Return only valid JSON."
            }
          ]
        },
        "options": {
          "returnIntermediateSteps": false
        }
      },
      "id": "basic-llm-chain",
      "name": "Vision AI Extraction",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI response and extract structured data\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    // Get the AI response text\n    let aiResponse = item.json.text || item.json.response || item.json.output || '';\n    \n    // Clean up the response - remove markdown code blocks if present\n    aiResponse = aiResponse.trim();\n    \n    // Remove ```json and ``` markers if present\n    if (aiResponse.startsWith('```json')) {\n      aiResponse = aiResponse.slice(7);\n    } else if (aiResponse.startsWith('```')) {\n      aiResponse = aiResponse.slice(3);\n    }\n    \n    if (aiResponse.endsWith('```')) {\n      aiResponse = aiResponse.slice(0, -3);\n    }\n    \n    aiResponse = aiResponse.trim();\n    \n    // Parse the JSON\n    const extractedData = JSON.parse(aiResponse);\n    \n    // Validate and normalize the data\n    const normalizedData = {\n      category: extractedData.category || 'Other',\n      vendor_name: extractedData.vendor_name || null,\n      document_date: extractedData.document_date || null,\n      total_amount: extractedData.total_amount !== undefined ? Number(extractedData.total_amount) : null,\n      currency: extractedData.currency || 'USD',\n      summary: extractedData.summary || null,\n      confidence_score: extractedData.confidence_score !== undefined ? Number(extractedData.confidence_score) : 0.5,\n      raw_response: aiResponse,\n      parsing_success: true,\n      parsing_error: null\n    };\n    \n    results.push({\n      json: {\n        ...item.json,\n        extracted: normalizedData\n      },\n      binary: item.binary\n    });\n    \n  } catch (error) {\n    // Handle parsing errors gracefully\n    results.push({\n      json: {\n        ...item.json,\n        extracted: {\n          category: 'Other',\n          vendor_name: null,\n          document_date: null,\n          total_amount: null,\n          currency: null,\n          summary: null,\n          confidence_score: 0,\n          raw_response: item.json.text || item.json.response || '',\n          parsing_success: false,\n          parsing_error: error.message\n        }\n      },\n      binary: item.binary\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "code-parse-json",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
