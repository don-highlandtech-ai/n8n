    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list",
          "cachedResultName": "GPT-4O"
        },
        "messages": {
          "values": [
            {
              "content": "You are an expert document processing assistant. Your job is to analyze documents (invoices, receipts, statements, contracts) and extract key information with high accuracy.\n\nYou must ALWAYS respond with valid JSON in this exact format:\n{\n  \"confidence\": 0.95,\n  \"document_type\": \"invoice|receipt|statement|contract|other\",\n  \"vendor_name\": \"Company Name\",\n  \"vendor_address\": \"Full address if visible\",\n  \"document_number\": \"Invoice/Receipt number\",\n  \"document_date\": \"YYYY-MM-DD\",\n  \"due_date\": \"YYYY-MM-DD or null\",\n  \"currency\": \"USD|EUR|GBP|etc\",\n  \"subtotal\": 0.00,\n  \"tax_amount\": 0.00,\n  \"total_amount\": 0.00,\n  \"payment_method\": \"Credit Card|Cash|Bank Transfer|etc or null\",\n  \"line_items\": [\n    {\n      \"description\": \"Item description\",\n      \"quantity\": 1,\n      \"unit_price\": 0.00,\n      \"total\": 0.00\n    }\n  ],\n  \"notes\": \"Any additional relevant information\",\n  \"extraction_warnings\": [\"List any fields that were unclear or estimated\"]\n}\n\nRules:\n1. Set 'confidence' between 0.0 and 1.0 based on image quality and data clarity\n2. If a field is not visible or applicable, use null\n3. Always use numbers without currency symbols for amounts\n4. Dates must be in YYYY-MM-DD format\n5. If the document is blurry or illegible, set confidence below 0.5 and list issues in extraction_warnings\n6. For line_items, extract as many as visible. Use empty array [] if none found",
              "role": "system"
            },
            {
              "content": "=Please analyze this document and extract all relevant information. The file name is: {{ $json.attachments.filename }}\n\nProvide your response as JSON only, no additional text.",
              "role": "user"
            }
          ]
        },
        "options": {
          "maxTokens": 4096,
          "temperature": 0.1
        }
      },
      "id": "openai-vision",
      "name": "OpenAI Vision Extract",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        900,
        100
      ],
      "credentials": {
        "openAiApi": {
          "id": "OPENAI_CREDENTIAL_ID",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI response and prepare data for sheets and drive\nconst input = $input.all();\nconst config = $('Set Config').first().json;\n\nlet results = [];\n\nfor (const item of input) {\n  try {\n    // Get the AI response text\n    let aiResponse = item.json.message?.content || item.json.text || item.json.output || '';\n    \n    // Clean up the response - remove markdown code blocks if present\n    aiResponse = aiResponse.replace(/```json\\n?/gi, '').replace(/```\\n?/gi, '').trim();\n    \n    // Parse the JSON response\n    let extractedData;\n    try {\n      extractedData = JSON.parse(aiResponse);\n    } catch (parseError) {\n      // If parsing fails, create error response\n      extractedData = {\n        confidence: 0,\n        document_type: 'unknown',\n        vendor_name: 'PARSE_ERROR',\n        total_amount: null,\n        extraction_warnings: ['Failed to parse AI response: ' + parseError.message]\n      };\n    }\n    \n    // Get original email and attachment info\n    const originalEmail = $('Gmail Trigger').first().json;\n    const attachment = $('Split Attachments').first().json.attachments || {};\n    \n    // Determine if we need to send alert\n    const confidenceThreshold = config.confidenceThreshold || 0.7;\n    const needsReview = extractedData.confidence < confidenceThreshold || \n                        !extractedData.vendor_name || \n                        !extractedData.total_amount ||\n                        extractedData.extraction_warnings?.length > 0;\n    \n    // Generate new filename based on extracted data\n    const date = extractedData.document_date || new Date().toISOString().split('T')[0];\n    const vendor = (extractedData.vendor_name || 'Unknown').replace(/[^a-zA-Z0-9]/g, '_').substring(0, 30);\n    const docType = extractedData.document_type || 'document';\n    const originalExt = attachment.filename?.split('.').pop() || 'pdf';\n    const newFilename = `${date}_${vendor}_${docType}.${originalExt}`;\n    \n    results.push({\n      json: {\n        // Extracted document data\n        ...extractedData,\n        \n        // Processing metadata\n        original_filename: attachment.filename,\n        new_filename: newFilename,\n        email_subject: originalEmail.subject,\n        email_from: originalEmail.from?.emailAddress || originalEmail.from,\n        email_date: originalEmail.date,\n        email_id: originalEmail.id,\n        processed_at: new Date().toISOString(),\n        \n        // Review flags\n        needs_review: needsReview,\n        confidence_threshold: confidenceThreshold,\n        \n        // Config pass-through\n        config: {\n          rootFolderId: config.rootFolderId,\n          spreadsheetId: config.spreadsheetId,\n          sheetName: config.sheetName,\n          notificationEmail: config.notificationEmail,\n          processedLabel: config.processedLabel\n        }\n      },\n      binary: item.binary\n    });\n    \n  } catch (error) {\n    results.push({\n      json: {\n        error: true,\n        error_message: error.message,\n        needs_review: true,\n        config: config\n      }\n    });\n  }\n}\n\nreturn results;"
      },
