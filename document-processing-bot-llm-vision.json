        "subject": "=⚠️ DocBot Alert: Document Needs Review - {{ $('Parse AI Response').item.json.vendor_name || 'Unknown Vendor' }}",
        "message": "=<h2>Document Processing Alert</h2>\n\n<p>The Document Processing Bot has flagged a document for your review.</p>\n\n<h3>Document Details</h3>\n<ul>\n  <li><strong>Original Filename:</strong> {{ $('Parse AI Response').item.json.original_filename }}</li>\n  <li><strong>Vendor:</strong> {{ $('Parse AI Response').item.json.vendor_name || 'Could not determine' }}</li>\n  <li><strong>Document Type:</strong> {{ $('Parse AI Response').item.json.document_type || 'Unknown' }}</li>\n  <li><strong>Total Amount:</strong> {{ $('Parse AI Response').item.json.currency || '' }} {{ $('Parse AI Response').item.json.total_amount || 'Not extracted' }}</li>\n  <li><strong>Document Date:</strong> {{ $('Parse AI Response').item.json.document_date || 'Not found' }}</li>\n</ul>\n\n<h3>Why This Needs Review</h3>\n<ul>\n  <li><strong>AI Confidence:</strong> {{ Math.round(($('Parse AI Response').item.json.confidence || 0) * 100) }}% (threshold: {{ Math.round(($('Parse AI Response').item.json.confidence_threshold || 0.7) * 100) }}%)</li>\n  <li><strong>Extraction Warnings:</strong> {{ $('Parse AI Response').item.json.extraction_warnings?.join(', ') || 'None' }}</li>\n</ul>\n\n<h3>Email Source</h3>\n<ul>\n  <li><strong>From:</strong> {{ $('Parse AI Response').item.json.email_from }}</li>\n  <li><strong>Subject:</strong> {{ $('Parse AI Response').item.json.email_subject }}</li>\n  <li><strong>Received:</strong> {{ $('Parse AI Response').item.json.email_date }}</li>\n</ul>\n\n<h3>Actions Taken</h3>\n<ul>\n  <li>✅ Document has been uploaded to Google Drive as: {{ $('Parse AI Response').item.json.new_filename }}</li>\n  <li>✅ Data has been logged to Google Sheets (marked for review)</li>\n  <li>⚠️ Please verify the extracted data in your spreadsheet</li>\n</ul>\n\n<p><em>This is an automated message from your Document Processing Bot.</em></p>",
        "options": {
          "appendAttribution": false
        }
      },
