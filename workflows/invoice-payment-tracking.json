{
  "name": "Invoice & Billing - Payment Status Tracking",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "notes": "PAYMENT STATUS POLLING\n\nRuns every 6 hours to check payment status for all open invoices.\n\nYou can adjust the frequency:\n- Every 6 hours (default)\n- Every hour (more responsive)\n- Every 12 hours (less API calls)"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-invoicing-provider",
              "name": "config.invoicingProvider",
              "value": "quickbooks",
              "type": "string"
            },
            {
              "id": "cfg-sheet-id",
              "name": "config.sheetId",
              "value": "YOUR_GOOGLE_SHEET_ID_HERE",
              "type": "string"
            },
            {
              "id": "cfg-sheet-tab",
              "name": "config.sheetTabName",
              "value": "Invoice Log",
              "type": "string"
            },
            {
              "id": "cfg-owner-email",
              "name": "config.ownerNotificationEmail",
              "value": "owner@yourcompany.com",
              "type": "string"
            },
            {
              "id": "cfg-escalation-days",
              "name": "config.escalationDaysOverdue",
              "value": 14,
              "type": "number"
            },
            {
              "id": "cfg-timezone",
              "name": "config.timezone",
              "value": "America/New_York",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "load-config",
      "name": "Load Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300],
      "notes": "CONFIGURATION\n\nMust match settings from main workflow:\n- sheetId: Same Google Sheet ID\n- sheetTabName: Same tab name\n- invoicingProvider: Must match main workflow\n- ownerNotificationEmail: For escalation alerts"
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.config.sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.config.sheetTabName }}"
        },
        "options": {
          "outputFormatting": true
        }
      },
      "id": "read-all-invoices",
      "name": "Read All Invoices from Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 300],
      "notes": "LOAD INVOICE LOG\n\nReads all invoices from the tracking sheet to check their current status."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "status-unpaid",
              "leftValue": "={{ $json.status }}",
              "rightValue": "Unpaid",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "status-sent",
              "leftValue": "={{ $json.status }}",
              "rightValue": "Sent",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "status-partial",
              "leftValue": "={{ $json.status }}",
              "rightValue": "Partially Paid",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "status-overdue",
              "leftValue": "={{ $json.status }}",
              "rightValue": "Overdue",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "filter-open-invoices",
      "name": "Filter Open Invoices",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [660, 300],
      "notes": "FILTER FOR OPEN INVOICES\n\nOnly process invoices with status:\n- Sent\n- Unpaid\n- Partially Paid\n- Overdue\n\nSkips Paid, Cancelled, Draft, Error statuses."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-qbo",
              "leftValue": "={{ $json.provider }}",
              "rightValue": "quickbooks",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-provider-qbo",
      "name": "Is QuickBooks?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-stripe",
              "leftValue": "={{ $json.provider }}",
              "rightValue": "stripe",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-provider-stripe",
      "name": "Is Stripe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 400]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://quickbooks.api.intuit.com/v3/company/YOUR_COMPANY_ID/invoice/' + $json.provider_invoice_id }}",
        "authentication": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "get-qbo-status",
      "name": "Get QuickBooks Invoice Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 100],
      "notes": "QUICKBOOKS STATUS CHECK\n\nFetches the current invoice status from QuickBooks.\n\nReplace YOUR_COMPANY_ID with your QuickBooks company ID.\nConnect your QuickBooks OAuth2 credential.",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "qbo-new-status",
              "name": "updated.status",
              "value": "={{ \n  $json.Invoice?.Balance === 0 ? 'Paid' :\n  $json.Invoice?.Balance < $json.Invoice?.TotalAmt ? 'Partially Paid' :\n  new Date($json.Invoice?.DueDate) < new Date() ? 'Overdue' : 'Unpaid'\n}}",
              "type": "string"
            },
            {
              "id": "qbo-amount-paid",
              "name": "updated.amount_paid",
              "value": "={{ $json.Invoice?.TotalAmt - $json.Invoice?.Balance }}",
              "type": "number"
            },
            {
              "id": "qbo-balance-due",
              "name": "updated.balance_due",
              "value": "={{ $json.Invoice?.Balance }}",
              "type": "number"
            },
            {
              "id": "qbo-dedupe-key",
              "name": "updated.dedupe_key",
              "value": "={{ $('Filter Open Invoices').item.json.dedupe_key }}",
              "type": "string"
            },
            {
              "id": "qbo-provider-status",
              "name": "updated.provider_status",
              "value": "={{ $json.Invoice?.status || 'Unknown' }}",
              "type": "string"
            }
          ]
        },
        "options": {
          "includeBinary": true
        },
        "include": "all"
      },
      "id": "map-qbo-status",
      "name": "Map QuickBooks Status",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 100]
    },
    {
      "parameters": {
        "resource": "invoice",
        "operation": "get",
        "invoiceId": "={{ $json.provider_invoice_id }}"
      },
      "id": "get-stripe-status",
      "name": "Get Stripe Invoice Status",
      "type": "n8n-nodes-base.stripe",
      "typeVersion": 2,
      "position": [1100, 300],
      "notes": "STRIPE STATUS CHECK\n\nFetches the current invoice status from Stripe.\n\nConnect your Stripe API credential.",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "stripe-new-status",
              "name": "updated.status",
              "value": "={{ \n  $json.status === 'paid' ? 'Paid' :\n  $json.status === 'void' ? 'Cancelled' :\n  $json.amount_remaining < $json.amount_due ? 'Partially Paid' :\n  new Date($json.due_date * 1000) < new Date() ? 'Overdue' : 'Unpaid'\n}}",
              "type": "string"
            },
            {
              "id": "stripe-amount-paid",
              "name": "updated.amount_paid",
              "value": "={{ ($json.amount_paid || 0) / 100 }}",
              "type": "number"
            },
            {
              "id": "stripe-balance-due",
              "name": "updated.balance_due",
              "value": "={{ ($json.amount_remaining || 0) / 100 }}",
              "type": "number"
            },
            {
              "id": "stripe-dedupe-key",
              "name": "updated.dedupe_key",
              "value": "={{ $('Filter Open Invoices').item.json.dedupe_key }}",
              "type": "string"
            },
            {
              "id": "stripe-provider-status",
              "name": "updated.provider_status",
              "value": "={{ $json.status }}",
              "type": "string"
            }
          ]
        },
        "options": {
          "includeBinary": true
        },
        "include": "all"
      },
      "id": "map-stripe-status",
      "name": "Map Stripe Status",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "pdf-new-status",
              "name": "updated.status",
              "value": "={{ new Date($json.due_date) < new Date() ? 'Overdue' : $json.status }}",
              "type": "string"
            },
            {
              "id": "pdf-amount-paid",
              "name": "updated.amount_paid",
              "value": "={{ $json.amount_paid || 0 }}",
              "type": "number"
            },
            {
              "id": "pdf-balance-due",
              "name": "updated.balance_due",
              "value": "={{ $json.balance_due || $json.total }}",
              "type": "number"
            },
            {
              "id": "pdf-dedupe-key",
              "name": "updated.dedupe_key",
              "value": "={{ $json.dedupe_key }}",
              "type": "string"
            },
            {
              "id": "pdf-provider-status",
              "name": "updated.provider_status",
              "value": "manual_tracking",
              "type": "string"
            }
          ]
        },
        "options": {
          "includeBinary": true
        },
        "include": "all"
      },
      "id": "check-pdf-overdue",
      "name": "Check PDF Only Overdue",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1100, 500],
      "notes": "PDF ONLY STATUS\n\nFor PDF-only invoices, we can only check if they are overdue based on due date.\n\nManual payment updates should be entered directly in the Google Sheet."
    },
    {
      "parameters": {},
      "id": "merge-statuses",
      "name": "Merge All Statuses",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1540, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "status-changed",
              "leftValue": "={{ $json.updated?.status }}",
              "rightValue": "={{ $('Filter Open Invoices').item.json.status }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "status-changed",
      "name": "Status Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1760, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Load Config').item.json.config.sheetId }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Load Config').item.json.config.sheetTabName }}"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "={{ $json.updated.status }}",
            "amount_paid": "={{ $json.updated.amount_paid }}",
            "balance_due": "={{ $json.updated.balance_due }}"
          },
          "matchingColumns": ["dedupe_key"],
          "schema": [
            {"id": "dedupe_key", "displayName": "dedupe_key", "required": false, "defaultMatch": true, "display": true, "type": "string", "canBeUsedToMatch": true},
            {"id": "status", "displayName": "status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false},
            {"id": "amount_paid", "displayName": "amount_paid", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": false},
            {"id": "balance_due", "displayName": "balance_due", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": false}
          ]
        },
        "options": {}
      },
      "id": "update-sheet-status",
      "name": "Update Sheet Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1980, 200],
      "notes": "UPDATE INVOICE LOG\n\nUpdates the status, amount_paid, and balance_due columns when a status change is detected."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-paid",
              "leftValue": "={{ $json.updated.status }}",
              "rightValue": "Paid",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-now-paid",
      "name": "Is Now Paid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2200, 200]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Load Config').item.json.config.ownerNotificationEmail }}",
        "subject": "={{ '[Payment Received] Invoice ' + $('Filter Open Invoices').item.json.invoice_number + ' - ' + $('Filter Open Invoices').item.json.client_name }}",
        "message": "={{ `<h2>Payment Received</h2>\n<p>Great news! A payment has been received:</p>\n<ul>\n<li><strong>Invoice:</strong> ${$('Filter Open Invoices').item.json.invoice_number}</li>\n<li><strong>Client:</strong> ${$('Filter Open Invoices').item.json.client_name}</li>\n<li><strong>Amount Paid:</strong> $${$json.updated.amount_paid.toFixed(2)}</li>\n<li><strong>Status:</strong> ${$json.updated.status}</li>\n</ul>\n<p>The invoice log has been automatically updated.</p>` }}",
        "options": {}
      },
      "id": "notify-payment-received",
      "name": "Notify Payment Received",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [2420, 100],
      "notes": "PAYMENT NOTIFICATION\n\nOptional: Sends notification when an invoice is fully paid.\n\nYou can disable this node if you don't want payment notifications."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "escalation-check",
              "leftValue": "={{ Math.floor((Date.now() - new Date($('Filter Open Invoices').item.json.due_date).getTime()) / (1000 * 60 * 60 * 24)) }}",
              "rightValue": "={{ $('Load Config').item.json.config.escalationDaysOverdue }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            },
            {
              "id": "is-overdue",
              "leftValue": "={{ $json.updated.status }}",
              "rightValue": "Overdue",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "needs-escalation",
      "name": "Needs Escalation?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2200, 400]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Load Config').item.json.config.ownerNotificationEmail }}",
        "subject": "={{ '[ESCALATION] Invoice ' + $('Filter Open Invoices').item.json.invoice_number + ' overdue ' + Math.floor((Date.now() - new Date($('Filter Open Invoices').item.json.due_date).getTime()) / (1000 * 60 * 60 * 24)) + ' days' }}",
        "message": "={{ `<h2>Invoice Escalation Alert</h2>\n<p>The following invoice requires attention:</p>\n<ul>\n<li><strong>Invoice:</strong> ${$('Filter Open Invoices').item.json.invoice_number}</li>\n<li><strong>Client:</strong> ${$('Filter Open Invoices').item.json.client_name} (${$('Filter Open Invoices').item.json.client_email})</li>\n<li><strong>Amount Due:</strong> $${$json.updated.balance_due.toFixed(2)}</li>\n<li><strong>Due Date:</strong> ${$('Filter Open Invoices').item.json.due_date}</li>\n<li><strong>Days Overdue:</strong> ${Math.floor((Date.now() - new Date($('Filter Open Invoices').item.json.due_date).getTime()) / (1000 * 60 * 60 * 24))}</li>\n</ul>\n<p><strong>Recommended Actions:</strong></p>\n<ol>\n<li>Contact the client directly via phone</li>\n<li>Review payment terms and consider collection actions</li>\n<li>Update invoice status in the sheet if resolved</li>\n</ol>\n${$('Filter Open Invoices').item.json.invoice_url ? '<p><a href=\"' + $('Filter Open Invoices').item.json.invoice_url + '\">View Invoice</a></p>' : ''}` }}",
        "options": {}
      },
      "id": "send-escalation",
      "name": "Send Escalation Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [2420, 400],
      "notes": "ESCALATION ALERT\n\nSends an escalation email to the owner when an invoice is overdue by more than the configured escalationDaysOverdue (default 14 days)."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "summary-processed",
              "name": "summary.invoices_checked",
              "value": "={{ $('Filter Open Invoices').all().length }}",
              "type": "number"
            },
            {
              "id": "summary-updated",
              "name": "summary.statuses_updated",
              "value": "={{ $('Status Changed?').all().length }}",
              "type": "number"
            },
            {
              "id": "summary-ts",
              "name": "summary.run_timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "run-summary",
      "name": "Run Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2640, 300]
    }
  ],
  "connections": {
    "Every 6 Hours": {
      "main": [
        [
          {
            "node": "Load Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Config": {
      "main": [
        [
          {
            "node": "Read All Invoices from Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read All Invoices from Sheet": {
      "main": [
        [
          {
            "node": "Filter Open Invoices",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Open Invoices": {
      "main": [
        [
          {
            "node": "Is QuickBooks?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Is Stripe?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is QuickBooks?": {
      "main": [
        [
          {
            "node": "Get QuickBooks Invoice Status",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Is Stripe?": {
      "main": [
        [
          {
            "node": "Get Stripe Invoice Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check PDF Only Overdue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get QuickBooks Invoice Status": {
      "main": [
        [
          {
            "node": "Map QuickBooks Status",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Map QuickBooks Status": {
      "main": [
        [
          {
            "node": "Merge All Statuses",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Stripe Invoice Status": {
      "main": [
        [
          {
            "node": "Map Stripe Status",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Map Stripe Status": {
      "main": [
        [
          {
            "node": "Merge All Statuses",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check PDF Only Overdue": {
      "main": [
        [
          {
            "node": "Merge All Statuses",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge All Statuses": {
      "main": [
        [
          {
            "node": "Status Changed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Status Changed?": {
      "main": [
        [
          {
            "node": "Update Sheet Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Run Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Sheet Status": {
      "main": [
        [
          {
            "node": "Is Now Paid?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Needs Escalation?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Now Paid?": {
      "main": [
        [
          {
            "node": "Notify Payment Received",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Needs Escalation?": {
      "main": [
        [
          {
            "node": "Send Escalation Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Notify Payment Received": {
      "main": [
        [
